[Unit]
Description=Flask App
After=network.target

[Service]
Type=simple
User=az
WorkingDirectory=/home/az/witec-demo
ExecStart=/usr/bin/python3 server.py
Restart=always
EnvironmentFile=-/home/az/witec-demo/.env
StandardOutput=append:/var/log/flask-app/access.log
StandardError=append:/var/log/flask-app/error.log

[Install]
WantedBy=multi-user.target
